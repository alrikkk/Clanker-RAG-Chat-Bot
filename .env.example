# Clanker Environment Configuration
# Copy this file to .env and configure variables as needed.

# Server settings
HOST=127.0.0.1
PORT=8000

# RAG Configuration
DOCS_DIR=data
EMBEDDING_MODEL=all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.40
TOP_K=3

# Optional LLM API Key (OpenAI or compatible endpoint)
# If left unset, Clanker runs in fully local, offline mode using its built-in extractor.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
